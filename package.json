{
  "name": "family-email",
  "version": "1.0.0",
  "description": "Serverless regex-based email routing using Cloudflare Email Workers",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "validate:config": "tsx scripts/validate-config.ts",
    "scan-secrets": "tsx scripts/scan-secrets.ts",
    "validate:secrets": "tsx scripts/scan-secrets.ts",
    "validate:docs": "tsx scripts/validate-docs.ts",
    "validate": "tsx scripts/validate-config.ts && tsx scripts/scan-secrets.ts && tsx scripts/validate-docs.ts && vitest run",
    "check": "tsc --noEmit && tsx scripts/validate-config.ts && tsx scripts/scan-secrets.ts && tsx scripts/validate-docs.ts && vitest run"
  },
  "keywords": [
    "cloudflare",
    "email-routing",
    "worker",
    "serverless",
    "regex-routing"
  ],
  "author": "vakh",
  "license": "MIT",
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261016.1",
    "@types/node": "^22.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^5.0.5",
    "wrangler": "^4.23.0"
  },
  "overrides": {
    "@fastify/busboy": "^3.2.2",
    "esbuild": "^0.25.12",
    "launch-editor": "^2.14.1",
    "postcss": "^8.5.28",
    "rollup": "^4.63.5",
    "sharp": "^0.35.5",
    "tinypool": "^2.2.0",
    "undici": "^7.29.0",
    "vite": "^6.3.5",
    "ws": "^8.21.3"
  }
}
